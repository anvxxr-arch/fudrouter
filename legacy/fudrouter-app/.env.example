# Fudrouter Configuration
# Copy this file to .env and fill in your values

# Required: Secret for API key generation (32+ characters)
API_KEY_SECRET=change-me-to-a-random-secret

# Server addresses
FUDROUTER_API_ADDR=0.0.0.0:8011
FUDROUTER_WEB_ADDR=0.0.0.0:8012
FUDROUTER_MITM_ADDR=:8443

# Data directory
FUDROUTER_DATA_DIR=/data

# Environment: production or development
FUDROUTER_ENV=production

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:8012,http://localhost:3000

# Rate limiting
RATE_LIMIT_RATE=10
RATE_LIMIT_CAPACITY=50

# MITM proxy (1=enabled, 0=disabled)
FUDROUTER_MITM=1
FUDROUTER_MITM_FALLBACK_ADDR=:8443
