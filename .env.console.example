# Console-scoped env ONLY -- the template for the live .env.console.
# The shared keys (DATABASE_URL, VALKEY_URL, CREDENTIALS_MASTER_KEY, BETTER_AUTH_SECRET,
# BETTER_AUTH_URL, ORIGIN, ROUTER_BASE_URL, PUBLIC_API_BASE_URL, FLEXYROUTE_*) live in the
# ROOT .env; apps/web/run.sh sources that first, this file second. One file per secret,
# so a rotation cannot be shadowed by a duplicate.
PORT=3002
