# Template for the React control plane's environment. Copy to `.env.react-web`
# at the repo root (that exact path is what apps/react-web/run.sh sources) and
# fill in real values. The real file is gitignored; this template is not, so a
# fresh clone can see every key the control plane needs.

# Port the control plane binds. Caddy path-splits the public host onto this
# port (the Go data plane owns :8100), so the two MUST agree. index.mjs falls
# back to 3000 when this is unset — a process started from a shell that does not
# export PORT would then come up on 3000 while Caddy proxies 3002 and the
# console would 502. Pin it here rather than relying on the starting shell.
PORT=3002

# Postgres. Same instance as the data plane.
DATABASE_URL=postgres://fudrouter:fudrouter@127.0.0.1:5432/fudrouter

# Better Auth. BETTER_AUTH_SECRET: openssl rand -base64 32. BETTER_AUTH_URL is
# the public origin the auth callbacks resolve against.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://ai.karepmuwes.my.id

# Go data plane (services/router), the [OI]-compatible hot path.
ROUTER_BASE_URL=http://127.0.0.1:8100

# Provider credentials master key (openssl rand -base64 32). MUST match the one
# the workers/scheduler fleet uses, or neither can decrypt the other's blobs.
CREDENTIALS_MASTER_KEY=

# Rotation window only — leave unset in the steady state.
#
# To rotate with no downtime: set this to the OLD key and CREDENTIALS_MASTER_KEY
# to the NEW one, restart the fleet, then re-encrypt every stored blob and drop
# this variable. While it is set, Decrypt tries the active key first and this one
# second, so rows written under the old key keep working and every write already
# uses the new key. A malformed value is a startup error, never silently ignored
# (that would make old rows undecryptable with no signal):
#   apps/react-web/server/lib/credentials.mjs (_masterKeyPrev)
#   services/router/internal/crypt/crypt.go (NewWithPrev)
#CREDENTIALS_MASTER_KEY_PREV=

# Valkey — shared host-native instance (systemd valkey-server.service). Logical
# DB 1 keeps fudrouter's keyspace separate from other projects on this host.
# Never hardcoded in app code (docs/specs/2026-09-30-platform-schema.md §12).
VALKEY_URL=redis://:valkey_dev@127.0.0.1:6379/1

# Public origin (auth callbacks, absolute links).
ORIGIN=https://ai.karepmuwes.my.id

# Discord OAuth (flexyroute bot).
FLEXYROUTE_BOT_TOKEN=
FLEXYROUTE_CLIENT_ID=
FLEXYROUTE_CLIENT_SECRET=
FLEXYROUTE_APPLICATION_ID=
FLEXYROUTE_PUBLIC_KEY=

# Data plane dev-provider opt-in. The web app reads the same variable so the
# admin console and public catalog agree with the router about what is live.
#
# UNSET deliberately. Migration 0004 promoted every provider to `active`, so the
# catalog no longer depends on this flag — measured 2026-09-30: the router serves
# 272 models with it set and 272 with it unset. It is now only a way to expose a
# `dev` row by accident, and a value set here would have to be set in the
# router's environment too or the two planes would disagree about reachability.
# See infra/.env.example for the full reasoning.
#ROUTER_ALLOW_DEV_PROVIDERS=

# Public base URL printed by the "Connect a client" snippets (no /v1).
PUBLIC_API_BASE_URL=https://ai.karepmuwes.my.id
