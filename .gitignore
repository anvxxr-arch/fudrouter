node_modules/
build/
dist/
bin/
.env
.env.*
!.env.example
# The control plane's template: `.env.*` would otherwise hide it, and without a
# tracked template a fresh clone cannot see which keys apps/web needs.
!.env.console.example
*.log
.DS_Store
infra/data/
*.tar.gz

# npm is the package manager for this repo (package-lock.json is the tracked
# lockfile; workspaces are npm workspaces). Lockfiles/artifacts from bun and pnpm
# are side effects of a tool that is not part of the toolchain and must never be
# committed — a third lockfile silently wins on some machines and installs a
# different tree than CI does.
bun.lock
bun.lockb
pnpm-lock.yaml
pnpm-workspace.yaml
node_modules/.pnpm/

# `patch`/`git apply` leftovers: a rejected hunk leaves these beside the target.
*.orig
*.rej

# `go test -c` / `go test -o proxy.test` leaves an 18MB unstripped ELF next to the
# package; the `bin/` entry above does not cover it and a stray one is one
# `git add -A` away from being committed. Go's test source is the `.go` file.
*.test

# Python bytecode from ops/verify/route-integrity/mock_upstream.py. One .pyc was
# committed and shipped for months: it is a build artifact of a file that is
# already in the tree, it breaks on any interpreter but the one that wrote it,
# and nothing reads it.
__pycache__/
*.pyc
*.pyo

# One-off investigation scratch space. Anything here is a single-sighting probe
# by definition; real tools get promoted into ops/verify/ and committed from there.
scratch/

# probe API key secret (minted for live router proofs) — never commit
.liveproof.key
