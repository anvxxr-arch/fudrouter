# Postgres (dev stack from infra/docker-compose.yml)
DATABASE_URL=postgres://fudrouter:fudrouter@127.0.0.1:5432/fudrouter

# Better Auth
BETTER_AUTH_SECRET=replace-me-with-openssl-rand-base64-32
# Public origin the app is served from — better-auth's baseURL and adapter-node
# both read ORIGIN. Session cookies bind to this host.
ORIGIN=http://127.0.0.1:3000

# Go data plane
ROUTER_BASE_URL=http://127.0.0.1:8100

# Serve providers with status='dev' (spec §1: non-commercial provider layers must
# not ship). Unset/falsey in production. Accepts 1/true/yes/on; anything else
# fails closed.
# ROUTER_ALLOW_DEV_PROVIDERS=1

# Provider credentials master key (openssl rand -base64 32)
CREDENTIALS_MASTER_KEY=replace-me-with-openssl-rand-base64-32

# Seed provider (any [OI]-compatible endpoint). Prices = micro-USD per 1M tokens.
SEED_PROVIDER_NAME=dev-upstream
SEED_PROVIDER_BASE_URL=http://127.0.0.1:20128/v1
SEED_PROVIDER_API_KEY=replace-me
SEED_MODEL_SLUG=dev-model
SEED_MODEL_NAME=Dev Model
SEED_MODEL_INPUT_PRICE=150000.000000
SEED_MODEL_OUTPUT_PRICE=600000.000000
SEED_MODEL_CURRENCY=USD

# xAI Grok onboarding (npm run onboard:xai) — reads the grok-register farm output.
# GROK_FARM_AUTH_DIR=/home/dwizzy/grok-register/cpa_auths
# XAI_PROVIDER_NAME=xai-grok
# XAI_BASE_URL=https://cli-chat-proxy.grok.com/v1
# XAI_CLI_VERSION=0.1.202
